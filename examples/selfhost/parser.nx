# Self-hosted parser for Nexum (stage 10c of the self-hosting plan).
#
# Parses the source file named by INPUT_FILE and prints it in the same
# normalized form as `nx parse`, so the two parsers can be compared
# statement by statement by the differential test in
# `crates/nexum-driver/tests/backend.rs`.
#
# The AST is a flat arena: a `List` of `Node` records whose children are
# referenced by index, plus a side table for the child lists that have a
# variable length (call arguments, array elements, block statements). A
# record cannot contain itself, so a tree of records is not expressible; an
# arena with indices is, and it is the data-oriented shape the spec prefers
# anyway.
#
# Scope: functions, `let`, assignment, expression statements, `return`,
# `if`/`else`, `while`, `for`, record declarations, `import` and type
# annotations. Path assignments (`a.b[i] = v`) are not parsed yet.
#
# The inline assembly builtin is parsed as a statement: `asm(dest, template,
# constraints, inputs...)`. The destination is the variable the result goes
# to, the template and the constraints are strings, and the rest are the
# inputs. A last argument that is a string literal names the target the
# block is for. The normalised form of the block is pinned by
# `specs/contracts/phase-11b-inline-asm.md`.

import "lexer_lib.nx"

type Node:
    kind: Str
    text: Str
    a: Int
    b: Int
    c: Int

fn spaces(n: Int) -> Str:
    let mut out = ""
    let mut i = 0
    while i < n:
        out = concat(out, " ")
        i = i + 1
    return out

# Escape a string so that it occupies exactly one line.
fn escape(s: Str) -> Str:
    let n = len(s)
    let mut out = ""
    let mut i = 0
    while i < n:
        let c = s[i]
        if c == "\\":
            out = concat(out, "\\\\")
        else:
            if c == "\n":
                out = concat(out, "\\n")
            else:
                if c == "\t":
                    out = concat(out, "\\t")
                else:
                    out = concat(out, c)
        i = i + 1
    return out

fn add_node(nodes: List, kind: Str, text: Str, a: Int, b: Int, c: Int) -> Int:
    list_push(nodes, Node(kind, text, a, b, c))
    return list_len(nodes) - 1

fn kind_at(tokens: List, i: Int) -> Str:
    let t = list_get(tokens, i)
    return t.kind

fn text_at(tokens: List, i: Int) -> Str:
    let t = list_get(tokens, i)
    return t.text

# Skip the newlines between statements.
fn skip_newlines(tokens: List, mut pos: Int):
    let mut more = true
    while more:
        if kind_at(tokens, pos) == "Newline":
            pos = pos + 1
        else:
            more = false

# --- operator tables, one per precedence level ---

fn or_op(k: Str) -> Str:
    if k == "KwOr":
        return "or"
    return ""

fn and_op(k: Str) -> Str:
    if k == "KwAnd":
        return "and"
    return ""

fn eq_op(k: Str) -> Str:
    if k == "EqEq":
        return "eq"
    if k == "BangEq":
        return "ne"
    return ""

fn cmp_op(k: Str) -> Str:
    if k == "Lt":
        return "lt"
    if k == "Gt":
        return "gt"
    if k == "LtEq":
        return "le"
    if k == "GtEq":
        return "ge"
    return ""

fn add_op(k: Str) -> Str:
    if k == "Plus":
        return "add"
    if k == "Minus":
        return "sub"
    return ""

fn mul_op(k: Str) -> Str:
    if k == "Star":
        return "mul"
    if k == "Slash":
        return "div"
    if k == "Percent":
        return "mod"
    return ""

# The compound assignment operators.
fn compound_op(k: Str) -> Str:
    if k == "PlusEq":
        return "add"
    if k == "MinusEq":
        return "sub"
    if k == "StarEq":
        return "mul"
    if k == "SlashEq":
        return "div"
    if k == "PercentEq":
        return "mod"
    return ""

# --- expressions ---

fn parse_or(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let mut lhs = parse_and(nodes, extra, tokens, pos)
    let mut more = true
    while more:
        let op = or_op(kind_at(tokens, pos))
        if op == "":
            more = false
        else:
            pos = pos + 1
            let rhs = parse_and(nodes, extra, tokens, pos)
            lhs = add_node(nodes, "binop", op, lhs, rhs, 0)
    return lhs

fn parse_and(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let mut lhs = parse_eq(nodes, extra, tokens, pos)
    let mut more = true
    while more:
        let op = and_op(kind_at(tokens, pos))
        if op == "":
            more = false
        else:
            pos = pos + 1
            let rhs = parse_eq(nodes, extra, tokens, pos)
            lhs = add_node(nodes, "binop", op, lhs, rhs, 0)
    return lhs

fn parse_eq(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let mut lhs = parse_cmp(nodes, extra, tokens, pos)
    let mut more = true
    while more:
        let op = eq_op(kind_at(tokens, pos))
        if op == "":
            more = false
        else:
            pos = pos + 1
            let rhs = parse_cmp(nodes, extra, tokens, pos)
            lhs = add_node(nodes, "binop", op, lhs, rhs, 0)
    return lhs

fn parse_cmp(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let mut lhs = parse_add(nodes, extra, tokens, pos)
    let mut more = true
    while more:
        let op = cmp_op(kind_at(tokens, pos))
        if op == "":
            more = false
        else:
            pos = pos + 1
            let rhs = parse_add(nodes, extra, tokens, pos)
            lhs = add_node(nodes, "binop", op, lhs, rhs, 0)
    return lhs

fn parse_add(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let mut lhs = parse_mul(nodes, extra, tokens, pos)
    let mut more = true
    while more:
        let op = add_op(kind_at(tokens, pos))
        if op == "":
            more = false
        else:
            pos = pos + 1
            let rhs = parse_mul(nodes, extra, tokens, pos)
            lhs = add_node(nodes, "binop", op, lhs, rhs, 0)
    return lhs

fn parse_mul(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let mut lhs = parse_unary(nodes, extra, tokens, pos)
    let mut more = true
    while more:
        let op = mul_op(kind_at(tokens, pos))
        if op == "":
            more = false
        else:
            pos = pos + 1
            let rhs = parse_unary(nodes, extra, tokens, pos)
            lhs = add_node(nodes, "binop", op, lhs, rhs, 0)
    return lhs

fn parse_unary(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let k = kind_at(tokens, pos)
    if k == "Minus":
        pos = pos + 1
        let e = parse_unary(nodes, extra, tokens, pos)
        return add_node(nodes, "unop", "neg", e, 0, 0)
    if k == "KwNot":
        pos = pos + 1
        let e = parse_unary(nodes, extra, tokens, pos)
        return add_node(nodes, "unop", "not", e, 0, 0)
    return parse_postfix(nodes, extra, tokens, pos)

# Postfix chains: field access `expr.field` and indexing `expr[index]`.
fn parse_postfix(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let mut e = parse_primary(nodes, extra, tokens, pos)
    let mut more = true
    while more:
        let k = kind_at(tokens, pos)
        if k == "Dot":
            pos = pos + 1
            let name = text_at(tokens, pos)
            pos = pos + 1
            e = add_node(nodes, "field", name, e, 0, 0)
        else:
            if k == "LBracket":
                pos = pos + 1
                let ix = parse_or(nodes, extra, tokens, pos)
                if kind_at(tokens, pos) == "RBracket":
                    pos = pos + 1
                e = add_node(nodes, "index", "", e, ix, 0)
            else:
                more = false
    return e

fn parse_primary(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let k = kind_at(tokens, pos)
    if k == "Int":
        let t = text_at(tokens, pos)
        pos = pos + 1
        return add_node(nodes, "int", t, 0, 0, 0)
    if k == "Float":
        let t = text_at(tokens, pos)
        pos = pos + 1
        return add_node(nodes, "float", t, 0, 0, 0)
    if k == "KwTrue":
        pos = pos + 1
        return add_node(nodes, "bool", "true", 0, 0, 0)
    if k == "KwFalse":
        pos = pos + 1
        return add_node(nodes, "bool", "false", 0, 0, 0)
    if k == "Str":
        let t = text_at(tokens, pos)
        pos = pos + 1
        return add_node(nodes, "str", t, 0, 0, 0)
    if k == "Ident":
        let name = text_at(tokens, pos)
        pos = pos + 1
        if kind_at(tokens, pos) == "LParen":
            pos = pos + 1
            # The arguments are collected in a local list first: a nested
            # call appends its own arguments to the side table while this one
            # is being parsed, so the arguments of a call are only
            # contiguous once the whole list has been parsed.
            let args = list_new()
            list_push(args, 0)
            let mut more = true
            while more:
                let kk = kind_at(tokens, pos)
                if kk == "RParen":
                    more = false
                else:
                    if kk == "Eof":
                        more = false
                    else:
                        let arg = parse_or(nodes, extra, tokens, pos)
                        list_push(args, arg)
                        if kind_at(tokens, pos) == "Comma":
                            pos = pos + 1
                        else:
                            more = false
            if kind_at(tokens, pos) == "RParen":
                pos = pos + 1
            let start = list_len(extra)
            let mut count = 0
            let mut i = 1
            let total = list_len(args)
            while i < total:
                list_push(extra, list_get(args, i))
                count = count + 1
                i = i + 1
            return add_node(nodes, "call", name, start, count, 0)
        return add_node(nodes, "var", name, 0, 0, 0)
    if k == "LParen":
        pos = pos + 1
        let e = parse_or(nodes, extra, tokens, pos)
        if kind_at(tokens, pos) == "RParen":
            pos = pos + 1
        return e
    if k == "LBracket":
        pos = pos + 1
        # As with call arguments, the elements are collected in a local list
        # so that they end up contiguous in the side table.
        let elems = list_new()
        list_push(elems, 0)
        let mut more = true
        while more:
            let kk = kind_at(tokens, pos)
            if kk == "RBracket":
                more = false
            else:
                if kk == "Eof":
                    more = false
                else:
                    let el = parse_or(nodes, extra, tokens, pos)
                    list_push(elems, el)
                    if kind_at(tokens, pos) == "Comma":
                        pos = pos + 1
                    else:
                        more = false
        if kind_at(tokens, pos) == "RBracket":
            pos = pos + 1
        let start = list_len(extra)
        let mut count = 0
        let mut i = 1
        let total = list_len(elems)
        while i < total:
            list_push(extra, list_get(elems, i))
            count = count + 1
            i = i + 1
        return add_node(nodes, "array", "", start, count, 0)
    # Not an expression: consume the token and yield an empty name.
    pos = pos + 1
    return add_node(nodes, "var", "", 0, 0, 0)

# --- types ---

# A type expression: a name, or an array type `[T; N]`.
fn parse_type(nodes: List, tokens: List, mut pos: Int) -> Int:
    if kind_at(tokens, pos) == "LBracket":
        pos = pos + 1
        let elem = parse_type(nodes, tokens, pos)
        if kind_at(tokens, pos) == "Semicolon":
            pos = pos + 1
        let mut size = "0"
        if kind_at(tokens, pos) == "Int":
            size = text_at(tokens, pos)
            pos = pos + 1
        if kind_at(tokens, pos) == "RBracket":
            pos = pos + 1
        return add_node(nodes, "array", size, elem, 0, 0)
    let name = text_at(tokens, pos)
    pos = pos + 1
    return add_node(nodes, "named", name, 0, 0, 0)

# --- statements ---

# A block is the statements between an Indent and the matching Dedent. The
# statements are collected in a local list so that they end up contiguous in
# the side table. `ret_type` is the return type of the enclosing function,
# or -1.
fn parse_block(nodes: List, extra: List, tokens: List, mut pos: Int, ret_type: Int) -> Int:
    skip_newlines(tokens, pos)
    let mut stmts = list_new()
    list_push(stmts, 0)
    if kind_at(tokens, pos) != "Indent":
        # A block that is not indented holds a single statement.
        let s = parse_stmt(nodes, extra, tokens, pos)
        if s >= 0:
            list_push(stmts, s)
    else:
        pos = pos + 1
        let mut more = true
        while more:
            skip_newlines(tokens, pos)
            let k = kind_at(tokens, pos)
            if k == "Dedent":
                more = false
            else:
                if k == "Eof":
                    more = false
                else:
                    let s = parse_stmt(nodes, extra, tokens, pos)
                    if s >= 0:
                        list_push(stmts, s)
        if kind_at(tokens, pos) == "Dedent":
            pos = pos + 1
    let start = list_len(extra)
    let mut count = 0
    let mut i = 1
    let total = list_len(stmts)
    while i < total:
        list_push(extra, list_get(stmts, i))
        count = count + 1
        i = i + 1
    return add_node(nodes, "block", "", start, count, ret_type)

fn parse_fn_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    pos = pos + 1
    let name = text_at(tokens, pos)
    pos = pos + 1
    if kind_at(tokens, pos) == "LParen":
        pos = pos + 1
    let params = list_new()
    list_push(params, 0)
    let mut more = true
    while more:
        let k = kind_at(tokens, pos)
        if k == "RParen":
            more = false
        else:
            if k == "Eof":
                more = false
            else:
                if k == "KwMut":
                    pos = pos + 1
                let pname = text_at(tokens, pos)
                pos = pos + 1
                let mut pty = -1
                if kind_at(tokens, pos) == "Colon":
                    pos = pos + 1
                    pty = parse_type(nodes, tokens, pos)
                list_push(params, add_node(nodes, "param", pname, pty, 0, 0))
                if kind_at(tokens, pos) == "Comma":
                    pos = pos + 1
                else:
                    more = false
    if kind_at(tokens, pos) == "RParen":
        pos = pos + 1
    let mut ret = -1
    if kind_at(tokens, pos) == "Arrow":
        pos = pos + 1
        ret = parse_type(nodes, tokens, pos)
    if kind_at(tokens, pos) == "Colon":
        pos = pos + 1
    let body = parse_block(nodes, extra, tokens, pos, ret)
    let start = list_len(extra)
    let mut count = 0
    let mut i = 1
    let total = list_len(params)
    while i < total:
        list_push(extra, list_get(params, i))
        count = count + 1
        i = i + 1
    return add_node(nodes, "fn", name, start, count, body)

fn parse_let_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    pos = pos + 1
    let mut kind = "let"
    if kind_at(tokens, pos) == "KwMut":
        pos = pos + 1
        kind = "let-mut"
    let name = text_at(tokens, pos)
    pos = pos + 1
    let name_node = add_node(nodes, "name", name, 0, 0, 0)
    let mut ty = -1
    if kind_at(tokens, pos) == "Colon":
        pos = pos + 1
        ty = parse_type(nodes, tokens, pos)
    if kind_at(tokens, pos) == "Eq":
        pos = pos + 1
    let value = parse_or(nodes, extra, tokens, pos)
    return add_node(nodes, kind, "", name_node, value, ty)

fn parse_return_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    pos = pos + 1
    let k = kind_at(tokens, pos)
    let mut value = -1
    if k == "Newline":
        value = -1
    else:
        if k == "Dedent":
            value = -1
        else:
            if k == "Eof":
                value = -1
            else:
                value = parse_or(nodes, extra, tokens, pos)
    return add_node(nodes, "return", "", value, 0, 0)

fn parse_if_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    pos = pos + 1
    let cond = parse_or(nodes, extra, tokens, pos)
    if kind_at(tokens, pos) == "Colon":
        pos = pos + 1
    let then_block = parse_block(nodes, extra, tokens, pos, -1)
    let mut else_block = -1
    if kind_at(tokens, pos) == "KwElse":
        pos = pos + 1
        if kind_at(tokens, pos) == "Colon":
            pos = pos + 1
        else_block = parse_block(nodes, extra, tokens, pos, -1)
    return add_node(nodes, "if", "", cond, then_block, else_block)

fn parse_while_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    pos = pos + 1
    let cond = parse_or(nodes, extra, tokens, pos)
    if kind_at(tokens, pos) == "Colon":
        pos = pos + 1
    let body = parse_block(nodes, extra, tokens, pos, -1)
    return add_node(nodes, "while", "", cond, body, 0)

fn parse_for_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    pos = pos + 1
    let var = text_at(tokens, pos)
    pos = pos + 1
    if kind_at(tokens, pos) == "KwIn":
        pos = pos + 1
    let first = parse_or(nodes, extra, tokens, pos)
    let mut iter = add_node(nodes, "each", "", first, 0, 0)
    if kind_at(tokens, pos) == "Range":
        pos = pos + 1
        let hi = parse_or(nodes, extra, tokens, pos)
        iter = add_node(nodes, "range", "", first, hi, 0)
    if kind_at(tokens, pos) == "Colon":
        pos = pos + 1
    let body = parse_block(nodes, extra, tokens, pos, -1)
    return add_node(nodes, "for", var, iter, body, 0)

# A record declaration: `type Name:` followed by the indented fields.
fn parse_type_decl(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    pos = pos + 1
    let name = text_at(tokens, pos)
    pos = pos + 1
    if kind_at(tokens, pos) == "Colon":
        pos = pos + 1
    let fields = list_new()
    list_push(fields, 0)
    skip_newlines(tokens, pos)
    if kind_at(tokens, pos) == "Indent":
        pos = pos + 1
        let mut more = true
        while more:
            skip_newlines(tokens, pos)
            let k = kind_at(tokens, pos)
            if k == "Dedent":
                more = false
            else:
                if k == "Eof":
                    more = false
                else:
                    let fname = text_at(tokens, pos)
                    pos = pos + 1
                    let mut ty = -1
                    if kind_at(tokens, pos) == "Colon":
                        pos = pos + 1
                        ty = parse_type(nodes, tokens, pos)
                    list_push(fields, add_node(nodes, "field", fname, ty, 0, 0))
        if kind_at(tokens, pos) == "Dedent":
            pos = pos + 1
    let start = list_len(extra)
    let mut count = 0
    let mut i = 1
    let total = list_len(fields)
    while i < total:
        list_push(extra, list_get(fields, i))
        count = count + 1
        i = i + 1
    return add_node(nodes, "type", name, start, count, 0)

fn parse_import_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    pos = pos + 1
    let path = text_at(tokens, pos)
    pos = pos + 1
    return add_node(nodes, "import", path, 0, 0, 0)

# An assignment starts with a name; the value follows the `=`.
fn parse_assign_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let name = text_at(tokens, pos)
    pos = pos + 1
    let name_node = add_node(nodes, "name", name, 0, 0, 0)
    let k = kind_at(tokens, pos)
    let mut kind = "assign"
    let mut op = ""
    if k == "Eq":
        op = ""
    else:
        op = compound_op(k)
        kind = "assign-op"
    pos = pos + 1
    let value = parse_or(nodes, extra, tokens, pos)
    return add_node(nodes, kind, op, name_node, value, 0)

# Is the statement at `pos` a path assignment (`a.b[i] = v`)? The scan
# looks for the lvalue shape - an identifier followed by `.name` and
# `[...]` segments - and then a top-level `=` or an `op=`. The bracket
# depth is tracked, so a comma or an operator inside `[...]` does not
# confuse the scan.
fn path_assign_ahead(tokens: List, pos: Int) -> Bool:
    let total = list_len(tokens)
    let mut j = pos + 1
    let mut depth = 0
    let mut is_path = true
    let mut found = false
    let mut more = true
    while more:
        if j >= total:
            more = false
        else:
            let k = kind_at(tokens, j)
            if k == "Dot":
                if depth == 0:
                    if j + 1 < total and kind_at(tokens, j + 1) == "Ident":
                        j = j + 2
                    else:
                        is_path = false
                        more = false
                else:
                    j = j + 1
            else:
                if k == "LBracket":
                    depth = depth + 1
                    j = j + 1
                else:
                    if k == "RBracket":
                        if depth == 0:
                            is_path = false
                            more = false
                        else:
                            depth = depth - 1
                            j = j + 1
                    else:
                        if depth == 0:
                            if k == "Eq":
                                found = true
                                more = false
                            else:
                                if compound_op(k) != "":
                                    found = true
                                    more = false
                                else:
                                    # The statement ends here.
                                    if k == "Newline" or k == "Eof" or k == "Indent" or k == "Dedent":
                                        more = false
                                    else:
                                        j = j + 1
                        else:
                            j = j + 1
    return is_path and found

# A path assignment: `a.b[i] = v` or `a.b[i] op= v`. The root is a name,
# the segments are fields and indexes, and the value follows the operator.
fn parse_path_assign_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let root = text_at(tokens, pos)
    pos = pos + 1
    let root_node = add_node(nodes, "root", root, 0, 0, 0)
    # The segments, in the order they were written. They are linked into a
    # chain afterwards, so that the printer can walk them in that order.
    let segs = list_new()
    list_push(segs, 0)
    let mut more = true
    while more:
        let k = kind_at(tokens, pos)
        if k == "Dot":
            pos = pos + 1
            let field = text_at(tokens, pos)
            pos = pos + 1
            list_push(segs, add_node(nodes, "path-field", field, 0, 0, 0))
        else:
            if k == "LBracket":
                pos = pos + 1
                let ix = parse_or(nodes, extra, tokens, pos)
                list_push(segs, add_node(nodes, "path-index", "", ix, 0, 0))
                if kind_at(tokens, pos) == "RBracket":
                    pos = pos + 1
            else:
                more = false
    # The operator.
    let k = kind_at(tokens, pos)
    let mut kind = "assign-path"
    let mut op = ""
    if k == "Eq":
        pos = pos + 1
    else:
        op = compound_op(k)
        kind = "assign-path-op"
        pos = pos + 1
    let value = parse_or(nodes, extra, tokens, pos)
    # Link the segments into a chain, in the order they were written.
    let mut chain = 0
    let mut i = list_len(segs) - 1
    while i >= 1:
        let s = list_get(segs, i)
        let seg = list_get(nodes, s)
        list_set(nodes, s, Node(seg.kind, seg.text, seg.a, chain, seg.c))
        chain = s
        i = i - 1
    return add_node(nodes, kind, op, root_node, chain, value)

# The inline assembly builtin: `asm(dest, template, constraints, inputs...)`.
# The destination is the variable the result of the block goes to, the
# template and the constraints are strings, and the rest are the inputs, in
# the order the constraint string names them. A last argument that is a
# string literal is the target guard: it names the target the block is for.
#
# The arguments are collected in a local list first, for the same reason the
# arguments of a call are: a nested call appends its own arguments to the
# side table while this one is being parsed, so the arguments are only
# contiguous once the whole list has been parsed.
fn parse_asm_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    pos = pos + 1
    pos = pos + 1
    let args = list_new()
    list_push(args, 0)
    let mut more = true
    while more:
        let kk = kind_at(tokens, pos)
        if kk == "RParen":
            more = false
        else:
            if kk == "Eof":
                more = false
            else:
                let arg = parse_or(nodes, extra, tokens, pos)
                list_push(args, arg)
                if kind_at(tokens, pos) == "Comma":
                    pos = pos + 1
                else:
                    more = false
    if kind_at(tokens, pos) == "RParen":
        pos = pos + 1
    # The arguments go into the side table, in the order they were written.
    let start = list_len(extra)
    let mut count = 0
    let mut i = 1
    let total = list_len(args)
    while i < total:
        list_push(extra, list_get(args, i))
        count = count + 1
        i = i + 1
    # The inputs are the arguments from the third on. The target guard, when
    # there is one, is the last argument and it is a string literal, so the
    # inputs are the ones before it.
    if count < 3:
        # The block needs a destination, a template and the constraints.
        # The Rust front end reports it and drops the statement, and the
        # self-hosted one drops it too: it has no diagnostics to report.
        return -1
    let mut ninputs = count - 3
    if ninputs > 0:
        let last = list_get(nodes, list_get(extra, start + count - 1))
        if last.kind == "str":
            ninputs = ninputs - 1
    return add_node(nodes, "asm", "", start, count, ninputs)

# A statement: one of the keyword forms, or an assignment, or an expression.
fn parse_stmt(nodes: List, extra: List, tokens: List, mut pos: Int) -> Int:
    let k = kind_at(tokens, pos)
    if k == "KwFn":
        return parse_fn_stmt(nodes, extra, tokens, pos)
    if k == "KwLet":
        return parse_let_stmt(nodes, extra, tokens, pos)
    if k == "KwReturn":
        return parse_return_stmt(nodes, extra, tokens, pos)
    if k == "KwIf":
        return parse_if_stmt(nodes, extra, tokens, pos)
    if k == "KwWhile":
        return parse_while_stmt(nodes, extra, tokens, pos)
    if k == "KwFor":
        return parse_for_stmt(nodes, extra, tokens, pos)
    if k == "KwType":
        return parse_type_decl(nodes, extra, tokens, pos)
    if k == "KwImport":
        return parse_import_stmt(nodes, extra, tokens, pos)
    if k == "Ident":
        # The inline assembly builtin: `asm(dest, template, constraints,
        # inputs...)`. It is a statement, so it is only recognised here and
        # not in an expression.
        if text_at(tokens, pos) == "asm" and kind_at(tokens, pos + 1) == "LParen":
            return parse_asm_stmt(nodes, extra, tokens, pos)
        # `name = value` and `name op= value` are assignments; anything else
        # that starts with a name is an expression statement.
        let k1 = kind_at(tokens, pos + 1)
        if k1 == "Eq":
            return parse_assign_stmt(nodes, extra, tokens, pos)
        if compound_op(k1) != "":
            return parse_assign_stmt(nodes, extra, tokens, pos)
        # `a.b[i] = value` is a path assignment.
        if path_assign_ahead(tokens, pos):
            return parse_path_assign_stmt(nodes, extra, tokens, pos)
    let e = parse_or(nodes, extra, tokens, pos)
    return add_node(nodes, "expr", "", e, 0, 0)

# --- the normalized form ---

# An expression on one line is not needed here: the `asm` block prints the
# destination and the inputs with the ordinary node printer, one level
# under the label.
fn asm_text(nodes: List, extra: List, idx: Int) -> Str:
    let n = list_get(nodes, idx)
    if n.kind == "str":
        return escape(n.text)
    # An argument that is not a string literal is not a string: the Rust
    # front end reads it as the empty string.
    return ""

# The `asm` block. The lines are the ones the contract pins:
#
#   asm
#     asm-dest <the destination expression>
#     asm-template <the template>
#     asm-constraints <the constraints>
#     asm-input <the input expression>
#     asm-target <the target>          (only when there is one)
#
# `start` is where the arguments start in the side table, `count` is how
# many there are and `ninputs` is how many of them are the inputs.
fn print_asm(nodes: List, extra: List, start: Int, count: Int, ninputs: Int, depth: Int):
    let pad = spaces(depth + 2)
    # the destination
    print(concat(pad, "asm-dest"))
    print_node(nodes, extra, list_get(extra, start), depth + 4)
    # the template
    let template = list_get(extra, start + 1)
    print(concat(pad, concat("asm-template ", asm_text(nodes, extra, template))))
    # the constraints
    let constraints = list_get(extra, start + 2)
    print(concat(pad, concat("asm-constraints ", asm_text(nodes, extra, constraints))))
    # the inputs
    let mut i = 0
    while i < ninputs:
        print(concat(pad, "asm-input"))
        print_node(nodes, extra, list_get(extra, start + 3 + i), depth + 4)
        i = i + 1
    # the target guard
    if count > 3 + ninputs:
        let target = list_get(extra, start + 3 + ninputs)
        print(concat(pad, concat("asm-target ", asm_text(nodes, extra, target))))

fn print_statements(nodes: List, extra: List, start: Int, count: Int, depth: Int):
    let mut i = 0
    while i < count:
        let child = list_get(extra, start + i)
        print_node(nodes, extra, child, depth)
        i = i + 1

# The path segments of a path assignment, in the order they were written.
fn print_path(nodes: List, extra: List, head: Int, depth: Int):
    let mut s = head
    while s > 0:
        let seg = list_get(nodes, s)
        if seg.kind == "path-field":
            print(concat(concat(spaces(depth), "path-field "), seg.text))
        else:
            print(concat(spaces(depth), "path-index"))
            print_node(nodes, extra, seg.a, depth + 2)
        s = seg.b

fn print_node(nodes: List, extra: List, idx: Int, depth: Int):
    let n = list_get(nodes, idx)
    let pad = spaces(depth)
    if n.kind == "binop":
        print(concat(concat(pad, "binop "), n.text))
        print_node(nodes, extra, n.a, depth + 2)
        print_node(nodes, extra, n.b, depth + 2)
        return
    if n.kind == "unop":
        print(concat(concat(pad, "unop "), n.text))
        print_node(nodes, extra, n.a, depth + 2)
        return
    if n.kind == "call":
        print(concat(concat(pad, "call "), n.text))
        print_statements(nodes, extra, n.a, n.b, depth + 2)
        return
    if n.kind == "asm":
        print(concat(pad, "asm"))
        print_asm(nodes, extra, n.a, n.b, n.c, depth)
        return
    if n.kind == "field":
        print(concat(concat(pad, "field "), n.text))
        print_node(nodes, extra, n.a, depth + 2)
        return
    if n.kind == "index":
        print(concat(pad, "index"))
        print_node(nodes, extra, n.a, depth + 2)
        print_node(nodes, extra, n.b, depth + 2)
        return
    if n.kind == "array":
        if n.text == "":
            # An array literal: the children are the elements.
            print(concat(pad, "array"))
            print_statements(nodes, extra, n.a, n.b, depth + 2)
            return
        # An array type: the child is the element type.
        print(concat(concat(pad, "array "), n.text))
        print_node(nodes, extra, n.a, depth + 2)
        return
    if n.kind == "str":
        print(concat(concat(pad, "str "), escape(n.text)))
        return
    if n.kind == "named":
        print(concat(concat(pad, "named "), n.text))
        return
    if n.kind == "fn":
        print(concat(concat(pad, "fn "), n.text))
        print_statements(nodes, extra, n.a, n.b, depth + 2)
        let body = list_get(nodes, n.c)
        if body.c >= 0:
            print(concat(spaces(depth + 2), "return-type"))
            print_node(nodes, extra, body.c, depth + 4)
        print_statements(nodes, extra, body.a, body.b, depth + 2)
        return
    if n.kind == "param":
        print(concat(concat(pad, "param "), n.text))
        if n.a >= 0:
            print(concat(pad, "param-type"))
            print_node(nodes, extra, n.a, depth + 2)
        return
    if n.kind == "let" or n.kind == "let-mut":
        print(concat(pad, n.kind))
        print_node(nodes, extra, n.a, depth + 2)
        if n.c >= 0:
            print(concat(spaces(depth + 2), "let-type"))
            print_node(nodes, extra, n.c, depth + 4)
        print_node(nodes, extra, n.b, depth + 2)
        return
    if n.kind == "assign":
        print(concat(pad, "assign"))
        print_node(nodes, extra, n.a, depth + 2)
        print_node(nodes, extra, n.b, depth + 2)
        return
    if n.kind == "assign-path":
        print(concat(pad, "assign-path"))
        print_node(nodes, extra, n.a, depth + 2)
        print_path(nodes, extra, n.b, depth + 2)
        print_node(nodes, extra, n.c, depth + 2)
        return
    if n.kind == "assign-path-op":
        print(concat(concat(pad, "assign-path-op "), n.text))
        print_node(nodes, extra, n.a, depth + 2)
        print_path(nodes, extra, n.b, depth + 2)
        print_node(nodes, extra, n.c, depth + 2)
        return
    if n.kind == "root":
        print(concat(concat(pad, "root "), n.text))
        return
    if n.kind == "assign-op":
        print(concat(concat(pad, "assign-op "), n.text))
        print_node(nodes, extra, n.a, depth + 2)
        print_node(nodes, extra, n.b, depth + 2)
        return
    if n.kind == "expr":
        print(concat(pad, "expr"))
        print_node(nodes, extra, n.a, depth + 2)
        return
    if n.kind == "return":
        print(concat(pad, "return"))
        if n.a >= 0:
            print_node(nodes, extra, n.a, depth + 2)
        return
    if n.kind == "if":
        print(concat(pad, "if"))
        print_node(nodes, extra, n.a, depth + 2)
        let then_block = list_get(nodes, n.b)
        print(concat(spaces(depth + 2), "then"))
        print_statements(nodes, extra, then_block.a, then_block.b, depth + 4)
        if n.c >= 0:
            let else_block = list_get(nodes, n.c)
            print(concat(spaces(depth + 2), "else"))
            print_statements(nodes, extra, else_block.a, else_block.b, depth + 4)
        return
    if n.kind == "while":
        print(concat(pad, "while"))
        print_node(nodes, extra, n.a, depth + 2)
        let body = list_get(nodes, n.b)
        print_statements(nodes, extra, body.a, body.b, depth + 2)
        return
    if n.kind == "for":
        print(concat(concat(pad, "for "), n.text))
        print_node(nodes, extra, n.a, depth + 2)
        let body = list_get(nodes, n.b)
        print_statements(nodes, extra, body.a, body.b, depth + 2)
        return
    if n.kind == "range":
        print(concat(pad, "range"))
        print_node(nodes, extra, n.a, depth + 2)
        print_node(nodes, extra, n.b, depth + 2)
        return
    if n.kind == "each":
        print(concat(pad, "each"))
        print_node(nodes, extra, n.a, depth + 2)
        return
    if n.kind == "type":
        print(concat(concat(pad, "type "), n.text))
        print_statements(nodes, extra, n.a, n.b, depth + 2)
        return
    if n.kind == "name":
        print(concat(concat(pad, "name "), n.text))
        return
    if n.kind == "import":
        print(concat(concat(pad, "import "), n.text))
        return
    # The default: the kind and its text.
    print(concat(concat(pad, n.kind), concat(" ", n.text)))

fn main():
    let src = read_file("nexum_selfhost_input.nx")
    let tokens = lex_tokens(src)
    # The element type of a list is fixed by its first push, and the first
    # push happens inside `add_node`, so it is fixed here with a placeholder.
    # Real nodes start at index 1.
    let nodes = list_new()
    list_push(nodes, Node("", "", 0, 0, 0))
    let extra = list_new()
    list_push(extra, 0)
    let mut pos = 0
    # The module is a list of statements.
    let stmts = list_new()
    list_push(stmts, 0)
    let mut more = true
    while more:
        skip_newlines(tokens, pos)
        let k = kind_at(tokens, pos)
        if k == "Eof":
            more = false
        else:
            if k == "Dedent":
                pos = pos + 1
            else:
                let s = parse_stmt(nodes, extra, tokens, pos)
                if s >= 0:
                    list_push(stmts, s)
    let start = list_len(extra)
    let mut count = 0
    let mut i = 1
    let total = list_len(stmts)
    while i < total:
        list_push(extra, list_get(stmts, i))
        count = count + 1
        i = i + 1
    print_statements(nodes, extra, start, count, 0)
