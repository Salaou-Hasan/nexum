# Self-hosted lexer driver for Nexum (stage 10b of the self-hosting plan).
#
# Reads the source file named by INPUT_FILE, tokenises it with the lexer in
# `lexer_lib.nx`, and prints the token stream in exactly the format that
# `nx lex` uses, so the two lexers can be compared token by token by the
# differential test in `crates/nexum-driver/tests/backend.rs`.

import "lexer_lib.nx"

fn main():
    let src = read_file("nexum_selfhost_input.nx")
    let tokens = lex_tokens(src)
    let mut k = 0
    let count = list_len(tokens)
    while k < count:
        let t = list_get(tokens, k)
        print(concat(t.kind, "\t"))
        print(t.text)
        k = k + 1
