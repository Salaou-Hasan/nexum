# Records: value semantics, nested construction, field access and assignment.

type Point:
    x: Float
    y: Float

type Segment:
    start: Point
    end: Point

fn dx(s):
    return s.end.x - s.start.x

fn dy(s):
    return s.end.y - s.start.y

fn len_sq(s):
    return dx(s) * dx(s) + dy(s) * dy(s)

fn main():
    let mut seg = Segment(Point(0.0, 0.0), Point(3.0, 4.0))
    print(len_sq(seg))
    seg.end.y = 12.0
    print(len_sq(seg))
