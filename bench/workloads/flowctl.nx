# Mixed control flow: backtracking recursion, nested loops with a guarded
# write, and loops whose trip count comes from the data.
#
# `bench/` has recursion (fib), straight-line loops (mandel, matmul,
# listsum, dot) and nothing between. Three shapes are missing, and all
# three are where branch layout and bounds checks actually show up:
#
#   * a recursive search that prunes and returns early inside a nested
#     loop (n-queens),
#   * a dynamic program whose inner loop writes conditionally and runs
#     backwards (0/1 knapsack),
#   * an unbounded loop whose exit depends on the value (Collatz).
#
# Two deliberate choices, both forced by the language:
#
#   * The board is three bitmasks rather than a list of column indices. A
#     list argument that the callee mutates, passed through a recursive
#     search, crashes the native backend on the default flag settings --
#     see the note in `deeptree.nx`. Ints also express the diagonals
#     directly: `<<1` and `>>1` carry the two diagonal masks forward.
#   * `n` is passed as an argument rather than read from a module binding
#     only so that the reference on the Rust side can be a plain function.
#     Every argument is an Int, so NX still memoizes `place` on this
#     workload and Rust does not, and part of this row is the
#     memoization pass rather than the search. That is a real difference in
#     what the language costs to run a pure recursive function, and it is
#     left in rather than hidden.

# --- n-queens, bitmask form -------------------------------------------
# `cmask` marks used columns, `d1` and `d2` the two diagonal families
# shifted one row per level.
fn ok(cmask, d1, d2, c):
    b = 1 << c
    if (cmask & b) != 0:
        return false
    if (d1 & b) != 0:
        return false
    if (d2 & b) != 0:
        return false
    return true

fn place(cmask, d1, d2, left, nn):
    if left == 0:
        return 1
    total = 0
    c = 0
    while c < nn:
        if ok(cmask, d1, d2, c):
            total = total + place(cmask | (1 << c), ((d1 | (1 << c)) << 1), ((d2 | (1 << c)) >> 1), left - 1, nn)
        c = c + 1
    return total

qtotal = 0
qsizes = 0
qn = 9
while qn <= 11:
    qtotal = qtotal + place(0, 0, 0, qn, qn)
    qsizes = qsizes + 1
    qn = qn + 1
print(qtotal, qsizes)

# --- 0/1 knapsack -----------------------------------------------------
# The inner loop runs downwards so each item is taken at most once, and
# writes only on an improvement.
cap = 20000
iw = []
iv = []
i = 0
while i < 48:
    push(iw, (i * 37 + 11) % 900 + 100)
    push(iv, (i * 613 + 29) % 4000 + 50)
    i = i + 1

best = []
i = 0
while i <= cap:
    push(best, 0)
    i = i + 1

i = 0
while i < len(iw):
    w = iw[i]
    v = iv[i]
    c = cap
    while c >= w:
        cand = best[c - w] + v
        if cand > best[c]:
            best[c] = cand
        c = c - 1
    i = i + 1
print(best[cap], best[cap // 3], best[0])

# --- Collatz over a fixed window --------------------------------------
# Trip count is a function of the value, so the loop cannot be unrolled or
# strength-reduced and the branch is genuinely unpredictable.
total = 0
longest = 0
i = 600000
while i < 700000:
    v = i
    steps = 0
    while v != 1:
        if v % 2 == 0:
            v = v // 2
        else:
            v = 3 * v + 1
        steps = steps + 1
    if steps > longest:
        longest = steps
    total = total + steps
    i = i + 1
print(total, longest)