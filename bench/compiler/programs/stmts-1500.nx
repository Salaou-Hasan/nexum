# seed[] is filled at run time with push, so seed[i] is a heap read
# through the runtime rather than a constant. Without this the whole
# chain above folds to one literal and the generated binary is the
# same size for every s, which would hide clang's real work here.
seed = []
i = 0
while i < 4:
    push(seed, (i * 7919 + 13) & 65535)
    i = i + 1

# The compile-time axis is the chain above, not the loop count, which
# is pinned at 4 so the program runs instantly.
fn step(k):
    i = 0
    acc = 0
    while i < 4:
        acc = (acc + work(seed[i], i + k)) & 65535
        i = i + 1
    return acc

print(step(7))
print(step(11))

