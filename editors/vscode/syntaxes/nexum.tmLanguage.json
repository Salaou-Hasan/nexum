{
  "scopeName": "source.nexum",
  "fileTypes": ["nx"],
  "name": "Nexum",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nexum",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nexum",
          "match": "\\b(fn|if|else|while|for|in|return|type|let|mut)\\b"
        },
        {
          "name": "keyword.operator.logical.nexum",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.nexum",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "storage.type.nexum",
          "match": "\\b(Int|Float|Bool|Str|Unit|Never)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nexum",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nexum",
              "match": "\\\\[ntr\\\\\"]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nexum",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.nexum",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.compound.nexum",
          "match": "(\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.comparison.nexum",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.nexum",
          "match": "(\\+|-|\\*|/|%|\\.{2})"
        },
        {
          "name": "keyword.operator.assignment.nexum",
          "match": "="
        },
        {
          "name": "punctuation.separator.nexum",
          "match": "(:|,|\\.|\\[|\\]|\\(|\\))"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.call.nexum",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}