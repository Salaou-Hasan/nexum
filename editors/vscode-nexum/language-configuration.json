{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^.*:\\s*(#.*)?$",
        "decreaseIndentPattern": "^\\s*(elif|else)\\b.*:\\s*(#.*)?$"
    },
    "onEnterRules": [
        {
            "beforeText": "^.*:\\s*(#.*)?$",
            "action": { "indentAction": "indent" }
        }
    ]
}
