{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "folding": {
        "offSide": true,
        "markers": {
            "start": "^\\s*#\\s*region\\b",
            "end": "^\\s*#\\s*endregion\\b"
        }
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(?:fn|type|impl|if|elif|else|for|while)\\b.*:\\s*(#.*)?$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "^\\s*$",
            "action": { "indent": "none" }
        }
    ]
}
