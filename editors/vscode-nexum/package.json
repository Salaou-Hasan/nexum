{
    "name": "vscode-nexum",
    "displayName": "Nexum",
    "description": "Nexum (.nx) language support: highlighting, indentation, brackets",
    "version": "0.4.7",
    "publisher": "HasanSalaou",
    "license": "MIT",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/Salaou-Hasan/nexum.git"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:nexum"
    ],
    "contributes": {
        "languages": [
            {
                "id": "nexum",
                "aliases": ["Nexum", "nx"],
                "extensions": [".nx"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "nexum",
                "scopeName": "source.nexum",
                "path": "./syntaxes/nexum.tmLanguage.json"
            }
        ],
        "iconThemes": [
            {
                "id": "nexum-icons",
                "label": "Nexum Icons",
                "path": "./fileicons/nexum-icons.json"
            }
        ],
        "commands": [
            {
                "command": "nexum.check",
                "title": "Nexum: Check current file",
                "category": "Nexum"
            }
        ],
        "configuration": {
            "title": "Nexum",
            "properties": {
                "nexum.executablePath": {
                    "type": "string",
                    "default": "nx",
                    "description": "Path to the nx compiler binary used for error checking."
                },
                "nexum.checkOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run nx check on save and show errors as squiggles."
                }
            }
        }
    }
}
