fn main():
    # Every comparison of two floats, and the boundaries around them.
    let a = 1.5
    let b = 2.5
    print(a < b)
    print(a > b)
    print(a <= b)
    print(a >= b)
    print(a == b)
    print(a != b)
    print(1.0 == 1.0)
    print(1.0 != 1.0)
    print(0.0 == -0.0)
    # The same comparisons on integers, which must not change.
    print(1 < 2)
    print(2 <= 2)
    print(3 > 4)
    print(3 >= 3)
    print(3 == 3)
    print(3 != 3)
